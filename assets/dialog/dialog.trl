(criterion IsGuard (class == guard))
(criterion IsLowestAlertness (alertness == lowest))
(criterion IsLowAlertness (alertness == low))
(criterion IsModerateAlertness (alertness == moderate))
(criterion IsHighAlertness (alertness == high))
(criterion ConceptPatrol (concept == patrol))
(criterion ConceptUpToLowAlertness (concept == up_to_low))
(criterion ConceptUpToModerateAlertness (concept == up_to_moderate))
(criterion ConceptUpToHighAlertness (concept == up_to_high))
(criterion ConceptDownToLowestAlertness (concept == down_to_lowest))
(criterion ConceptDownToLowAlertness (concept == down_to_low))
(criterion ConceptDownToModerateAlertness (concept == down_to_moderate))

(rule GuardPatrolLowest (ConceptPatrol IsGuard IsLowestAlertness) (GuardPatrolLowestBarks))
(rule GuardPatrolLow (ConceptPatrol IsGuard IsLowAlertness) (GuardPatrolLowBarks))
(rule GuardUpToLow (ConceptUpToLowAlertness IsGuard) (GuardUpToLowAlertnessBarks))
(rule GuardUpToModerate (ConceptUpToModerateAlertness IsGuard) (GuardUpToModerateAlertnessBarks))
(rule GuardUpToHigh (ConceptUpToHighAlertness IsGuard) (GuardUpToHighAlertnessBarks))
(rule GuardDownToLowest (ConceptDownToLowestAlertness IsGuard) (GuardDownToLowestAlertnessBarks))
(rule GuardDownToLow (ConceptDownToLowAlertness IsGuard) (GuardDownToLowAlertnessBarks))
(rule GuardDownToModerate (ConceptDownToModerateAlertness IsGuard) (GuardDownToModerateAlertnessBarks))


(response GuardPatrolLowestBarks shuffle
    (line "audio/sound_effects/barks/patrol/patrol_lowest-1.ogg" priority "0")
    (line "audio/sound_effects/barks/patrol/patrol_lowest-2.ogg" priority "0")
    (line "audio/sound_effects/barks/patrol/patrol_lowest-3.ogg" priority "0")
    ()
)

(response GuardPatrolLowBarks shuffle
    (line "audio/sound_effects/barks/patrol/patrol_low-1.ogg" priority "0")
    (line "audio/sound_effects/barks/patrol/patrol_low-2.ogg" priority "0")
    (line "audio/sound_effects/barks/patrol/patrol_low-3.ogg" priority "0")
    ()
)

(response GuardUpToLowAlertnessBarks shuffle
    (line "audio/sound_effects/barks/up_to_low/up_to_low-1.ogg" priority "2")
)

(response GuardUpToModerateAlertnessBarks shuffle
    (line "audio/sound_effects/barks/up_to_moderate/up_to_moderate-1.ogg" priority "3")
)

(response GuardUpToHighAlertnessBarks shuffle
    (line "audio/sound_effects/barks/up_to_high/up_to_high-1.ogg" priority "4")
)

(response GuardDownToLowestAlertnessBarks shuffle
    (line "audio/sound_effects/barks/down_to_lowest/down_to_lowest-1.ogg" priority "1")
    (line "audio/sound_effects/barks/down_to_lowest/down_to_lowest-2.ogg" priority "1")
)

(response GuardDownToLowAlertnessBarks shuffle
    (line "audio/sound_effects/barks/down_to_low/down_to_low-1.ogg" priority "2")
)

(response GuardDownToModerateAlertnessBarks shuffle
    (line "audio/sound_effects/barks/down_to_moderate/down_to_moderate-1.ogg" priority "3")
)


(response Default () (line "No matching dialog. Goodbye!"))
